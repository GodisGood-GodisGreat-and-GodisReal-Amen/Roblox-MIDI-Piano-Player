#!/bin/bash
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
export ROBLOX_MIDI_PLAYER_EXECUTABLE="$DIR/RobloxMidiPianoPlayer"
# LaunchServices may start this script under Rosetta (it cannot read an
# architecture from a shell script), and osascript then inherits x86_64. The
# native window UI must run as arm64 on Apple silicon, so re-exec natively.
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = "1" ]; then
  exec /usr/bin/arch -arm64 /usr/bin/osascript -l JavaScript "$DIR/../Resources/main.js" "$@"
fi
exec /usr/bin/osascript -l JavaScript "$DIR/../Resources/main.js" "$@"
